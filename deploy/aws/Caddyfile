# SITE_ADDRESS is a name that points at this instance, such as 1-2-3-4.sslip.io.
# Caddy gets its certificate on its own, so ports 80 and 443 must be open.
# Only the API is served here: the frontend is hosted separately and reaches it
# through a rewrite of /api on its own domain.
{$SITE_ADDRESS} {
	encode gzip

	handle /api/* {
		reverse_proxy voltia:8080
	}

	handle /healthz {
		reverse_proxy voltia:8080
	}

	handle {
		respond "VoltIA API. La interfaz esta en otro repositorio." 404
	}
}
