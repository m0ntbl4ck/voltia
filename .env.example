PORT=8080
DATABASE_URL=postgres://voltia:voltia@localhost:5432/voltia?sslmode=disable
JWT_SECRET=change-me
PLANT_TZ=America/Bogota

# gemini, anthropic or template. Without an API key the template explainer is used.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Pause after each analysis stage so the progress is readable in the demo. Use 0s to disable.
ANALYSIS_STAGE_DELAY=300ms
